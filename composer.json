{
    "name": "turahe/mailclient",
    "description": "",
    "authors": [
        {
            "name": "Nur Wachid",
            "email": "wachid@outlook.com"
        }
    ],
    "repositories": [{
        "type": "composer",
        "url": "https://packagist.wach.id"
    }],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ddeboer/imap": "^1.19",
        "kub-at/php-simple-html-dom-parser": "^1.9",
        "pelago/emogrifier": "^7.2.0",
        "turahe/core": "^1.0",
        "turahe/media": "^1.0",
        "willdurand/email-reply-parser": "^2.10",
        "zbateson/mail-mime-parser": "^3.0.3"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Turahe\\MailClient\\MailClientServiceProvider"
            ],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Turahe\\MailClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Turahe\\MailClient\\Tests\\": "tests/"
        }
    },

    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    }
}
