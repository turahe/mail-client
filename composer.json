        {
            "name": "Nur Wachid",
            "email": "wachid@outlook.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ddeboer/imap": "^1.19",
        "kub-at/php-simple-html-dom-parser": "^1.9",
        "pelago/emogrifier": "^7.2.0",
        "zbateson/mail-mime-parser": "^3.0.3"
