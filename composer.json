{
    "name": "turahe/mailclient",
    "description": "A comprehensive Laravel mail client package for managing email accounts, messages, and folders",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Wachid",
            "email": "wachid@outlook.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ddeboer/imap": "^1.19",
        "kub-at/php-simple-html-dom-parser": "^1.9",
        "pelago/emogrifier": "^7.2.0",
        "turahe/core": "^1.0",
        "turahe/media": "^3.0",
        "willdurand/email-reply-parser": "^2.10",
        "zbateson/mail-mime-parser": "^3.0.3"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0",
        "enlightn/security-checker": "^1.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Turahe\\MailClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Turahe\\MailClient\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "aliases": {},
            "providers": [
                "Turahe\\MailClient\\MailClientServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse",
        "fix": "php-cs-fixer fix",
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "security-check": "security-checker security:check composer.lock",
        "build": "box compile"
    }
}
